<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reactive_robot_sim</name>
  <version>2.0.0</version>
  <description>ITU ROVER Reactive Robot Assignment — simulation package (ROS 2 port).</description>
  <maintainer email="berkayycavusoglu@gmail.com">Berkay Cavusoglu</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Simülasyon ortamı bağımlılıkları (ROS 2 / Gazebo Classic) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- gazebo_ros_paths_plugin bu export'ları GAZEBO_MODEL_PATH ve
         GAZEBO_MEDIA_PATH'e ekler; böylece model://reactive_robot_sim/... URI'leri çalışır. -->
    <gazebo_ros gazebo_model_path="${prefix}/share/reactive_robot_sim/models"/>
    <gazebo_ros gazebo_media_path="${prefix}/share/reactive_robot_sim"/>
  </export>
</package>
