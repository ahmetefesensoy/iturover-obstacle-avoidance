<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>solution_kompleks_fgm_dwa</name>
  <version>2.0.0</version>
  <description>Çözüm — kapsamlı FGM + DWA hibriti (kapı durum makinesi, IFGM, arbiter, grid-BFS, SWEEP) reaktif kontrolcü (ROS 2 portu).</description>
  <maintainer email="ahmetefesensoy2011@gmail.com">Ahmet Efe Sensoy</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>reactive_robot_sim</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
