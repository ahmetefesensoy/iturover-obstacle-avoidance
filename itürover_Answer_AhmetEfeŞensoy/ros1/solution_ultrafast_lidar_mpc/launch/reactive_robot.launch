<launch>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="false"/>

  <include file="$(find reactive_robot_sim)/launch/reactive_robot_sim.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="model" value="burger_rgbd"/>
    <arg name="ground_truth" value="false"/>
  </include>

  <node name="ultrafast_lidar_mpc" pkg="ultrafast_lidar_mpc"
        type="ultrafast_lidar_mpc_node" output="screen" required="true">
    <rosparam command="load" file="$(find ultrafast_lidar_mpc)/config/race.yaml"/>
  </node>
</launch>
